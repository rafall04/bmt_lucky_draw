{
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "overrides": [
        {
            "files": "*.blade.php",
            "options": {
                "parser": "html",
                "printWidth": 120,
                "tabWidth": 4
            }
        },
        {
            "files": "*.php",
            "options": {
                "parser": "php",
                "printWidth": 120,
                "tabWidth": 4
            }
        }
    ]
}

